{
  "name": "omp-ui",
  "version": "0.1.1",
  "description": "Self-hosted kanban web UI for the omp (oh-my-pi) AI coding agent: plan, build, review, ship cards as PRs. Developer-friendly CLI and REST API.",
  "keywords": [
    "omp",
    "omp-ui",
    "oh-my-pi",
    "ai",
    "coding-agent",
    "ai-agent",
    "kanban",
    "self-hosted",
    "llm",
    "claude",
    "developer-tools",
    "web-ui",
    "agent-orchestration",
    "sdlc",
    "kanban-board",
    "devtools"
  ],
  "homepage": "https://github.com/quangpl/omp-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quangpl/omp-ui.git"
  },
  "bugs": {
    "url": "https://github.com/quangpl/omp-ui/issues"
  },
  "author": "quang",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.72.0",
    "mongodb": "^7.8.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pm2": "^6.0.14",
    "radix-ui": "^1.8.1",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "omp-ui": "bin/omp-ui.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "dist",
    "ecosystem.config.cjs",
    "omp-ui.service",
    ".env.example"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node dist/standalone/server.js",
    "up": "node bin/omp-ui.mjs up",
    "cli": "node bin/omp-ui.mjs",
    "typecheck": "tsc --noEmit",
    "pm2": "node bin/omp-ui.mjs pm2 start",
    "pm2:stop": "node bin/omp-ui.mjs pm2 stop",
    "pm2:logs": "node bin/omp-ui.mjs pm2 logs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/cli/**'",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "prepack": "vite build"
  },
  "publishConfig": {
    "access": "public"
  }
}
