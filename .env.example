# OMP UI configuration. `omp-ui init` (or `omp-ui up`) writes a ready-to-use .env;
# copy this file to .env only if you prefer to configure by hand. Keep .env private.

# ─── Server ──────────────────────────────────────────────────────────────────
# HTTP port (Docker: the host port mapped to the container's 3000).
PORT=3000
# Interface to bind. 0.0.0.0 = reachable from your LAN/phone; 127.0.0.1 = this machine only.
HOST=0.0.0.0

# ─── Storage ─────────────────────────────────────────────────────────────────
# Runtime data: SQLite database, logs, pid & tunnel files. Relative to the project folder.
DATA_DIR=./data
# Database. Default: sqlite:${DATA_DIR}/omp-ui.db
#   SQLite:     sqlite:./data/omp-ui.db   (or file:./data/omp-ui.db)
#   MongoDB:    mongodb://localhost:27017/omp_ui   (or mongodb+srv://…)
#   PostgreSQL: postgres://user:password@localhost:5432/omp_ui   (or postgresql://…)
DATABASE_URL=sqlite:./data/omp-ui.db
# MongoDB database name, used when the MongoDB URL has no /<db> path.
MONGODB_DB=omp_ui

# ─── Auth ────────────────────────────────────────────────────────────────────
# Admin password (min 8 chars). Applied at every boot and overwrites the stored one.
# Change it with `omp-ui passwd`. Leave empty to set it in the browser on first visit.
ADMIN_PASSWORD=
# Secret used to sign session tokens (64 hex chars). Empty = generated once and stored in the DB.
AUTH_SECRET=

# ─── Agents ──────────────────────────────────────────────────────────────────
# omp executable: a name on PATH or an absolute path (installer default: ~/.local/bin/omp).
OMP_PATH=omp
# Max omp agents running at once; extra runs wait in "queued". `auto` (default) derives it from
# the CPU cores and free memory (~600 MB per agent), re-checked every 30s; a number is a fixed cap (1-16).
MAX_AGENTS=auto
# Extra flags appended to every omp spawn (space-separated), e.g. --thinking=high --no-lsp
OMP_EXTRA_ARGS=

# ─── Self-healing (bin/supervisor.mjs) ───────────────────────────────────────
# The supervisor restarts a crashed server and force-restarts one whose /api/v1/health fails
# OMP_UI_HEALTH_FAILURES checks in a row (0 = never). Times in milliseconds.
# OMP_UI_HEALTH_INTERVAL_MS=15000
# OMP_UI_HEALTH_TIMEOUT_MS=10000
# OMP_UI_HEALTH_FAILURES=3
# OMP_UI_HEALTH_GRACE_MS=120000

# ─── Memory (agentmemory) ────────────────────────────────────────────────────
# Persistent agent memory via agentmemory (https://github.com/rohitg00/agentmemory). Install once
# with `npx -y @agentmemory/agentmemory@latest`, then Settings → Memory → Connect OMP.
# auto (default): `omp-ui up` and the supervisor start its server when it is installed (an enabled
# `systemctl --user` unit agentmemory.service is used when present); true: also warn when it is
# missing; false: never start it. Card runs remember under their board's project either way.
# AGENTMEMORY_ENABLED=auto
# REST API and viewer (defaults; the viewer binds to the server host's loopback).
# AGENTMEMORY_URL=http://127.0.0.1:3111
# AGENTMEMORY_VIEWER_URL=http://127.0.0.1:3113
# Pin every card's memory project instead of the board folder's git root name.
# AGENTMEMORY_PROJECT_NAME=
# How often the supervisor re-checks the memory server (ms; 0 = only at boot).
# OMP_UI_MEMORY_CHECK_MS=300000
# Docker only: AGENTMEMORY_VERSION=latest bakes agentmemory into the image (`docker compose build`);
# AGENTMEMORY_CONNECT_OMP=false stops the entrypoint from connecting the mounted omp config.
# AGENTMEMORY_VERSION=
# AGENTMEMORY_CONNECT_OMP=true

# ─── Projects & Git ──────────────────────────────────────────────────────────
# Projects folder: where the folder picker starts and where "Clone a Git repository" puts repos.
# Default: ~/omp-workspace (Docker: this host folder is mounted at /workspace).
WORKSPACE_DIR=
# Credentials (provider API keys, GH_TOKEN, GITLAB_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, proxies, …) can stay in
# your host environment: `omp-ui up`/`start` pass the whole shell environment to the server and its
# agents, and docker-compose.yml passes them into the container. Values set here only override them.
# omp, Claude, git, gh and glab sign-ins on this machine are used as they are; `omp-ui doctor` lists them.
# Tokens for "Create PR/MR" and HTTPS pushes (alternative to `gh auth login` / `glab auth login`).
# GH_TOKEN=
# GITLAB_TOKEN=

# ─── Reverse proxy ───────────────────────────────────────────────────────────
# Set to 1 when behind a TLS reverse proxy (Caddy, nginx, Traefik) so X-Forwarded-* headers are trusted.
# VINEXT_TRUST_PROXY=1

# ─── Docker Compose only ─────────────────────────────────────────────────────
# Host folder with omp's provider auth/config (mounted at /home/omp/.omp).
# OMP_HOME=~/.omp
# Bundled database service. Set by `omp-ui docker up --mongo|--postgres`:
# COMPOSE_PROFILES=postgres
# COMPOSE_DATABASE_URL=postgres://omp_ui:<POSTGRES_PASSWORD>@postgres:5432/omp_ui
# COMPOSE_DATABASE_URL=mongodb://mongo:27017/omp_ui
# Password of the bundled PostgreSQL service (generated by `omp-ui docker up --postgres`).
# POSTGRES_PASSWORD=
# MongoDB image used by `omp-ui docker --mongo` (use mongo:4.4 on CPUs without AVX)
# MONGO_IMAGE=mongo:7
